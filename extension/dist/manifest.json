{
  "manifest_version": 3,
  "name": "draft-kit",
  "version": "0.9.0",
  "description": "Draft thoughtful DMs and posts using your approved career experience.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open draft-kit"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:*"
  }
}
